# Dependencies
node_modules/

# Build output
.next/
dist/
build/
out/

# Verification artifacts (logs are kept, screenshots are not)
frontend/.verify/*.png
*.tsbuildinfo

# Local Postgres data directory (embedded-postgres, machines without Docker)
.pgdata/

# Runtime object storage (FILES_DIR default) and CLI logs — generated, never source
backend/var/

# Env files — .env.example is committed, real env files are not
.env
.env.*
!.env.example

# The test run's own JSON report (CI writes it, then assert-test-report.mjs reads it)
backend/test-report.json

# Logs and OS noise
*.log
.DS_Store
Thumbs.db
