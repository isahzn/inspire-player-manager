# Inspire Academy backend — environment template.
# Copy to .env for local development. Never commit real values (SECURITY_AND_PRIVACY §5).
#
# Names in the "documented" blocks are frozen by DEPLOYMENT_AND_OPERATIONS §4 — do not
# rename them. Blocks marked "(implementation detail)" are additions this code needs and
# are candidates for a spec update in the handoff.

# --- Documented: runtime -----------------------------------------------------
NODE_ENV=development
APP_ENV=development
APP_BASE_URL=http://localhost:3100
API_BASE_URL=http://localhost:3200
CORS_ALLOWED_ORIGINS=http://localhost:3100
LOG_LEVEL=info
# SENTRY_DSN=

# --- Implementation detail: http ---------------------------------------------
PORT=3200
TRUST_PROXY=false

# --- Documented: database ----------------------------------------------------
# Runtime role: no DDL, no BYPASSRLS (DATABASE §7).
DATABASE_URL=postgres://ia_app:ia_app_dev_password@localhost:55432/ia_dev
# DDL role: owns objects, runs migrations.
DATABASE_MIGRATOR_URL=postgres://ia_migrator:ia_migrator_dev_password@localhost:55432/ia_dev
# Superuser, used ONLY by the one-time local role bootstrap (scripts/bootstrap-roles.ts).
DATABASE_SUPERUSER_URL=postgres://postgres:ia_postgres_dev_password@localhost:55432/postgres

# --- Implementation detail: database -----------------------------------------
DB_STATEMENT_TIMEOUT_MS=5000
DB_POOL_MAX=10

# --- Documented: sessions, cookies, CSRF -------------------------------------
COOKIE_DOMAIN=
SESSION_COOKIE_SECRET=dev-only-session-cookie-secret-replace-me-32b
CSRF_SECRET=dev-only-csrf-secret-replace-me-32-bytes-ok

# --- Implementation detail: session behaviour (defaults from AUTH §1) ---------
SESSION_COOKIE_NAME=ia_session
COOKIE_SECURE=false
OWNER_IDLE_MINUTES=120
OWNER_ABSOLUTE_HOURS=12
COACH_IDLE_HOURS=24
COACH_ABSOLUTE_DAYS=14
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

# --- Documented: TOTP --------------------------------------------------------
# 32-byte random key; encrypts users.totp_secret_enc at rest.
TOTP_ENCRYPTION_KEY=dev-only-totp-encryption-key-32-bytes-long

# --- Documented: object storage (private bucket; MinIO in dev) ---------------
STORAGE_ENDPOINT=http://localhost:59000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=ia-private
STORAGE_ACCESS_KEY_ID=ia_minio_dev
STORAGE_SECRET_ACCESS_KEY=ia_minio_dev_password

# --- Implementation detail: storage ------------------------------------------
# local (a private directory, the v1 default) | s3 (an S3-compatible bucket).
# `s3` without the five STORAGE_* values above is a startup failure, never a silent fall
# back to a directory nobody backs up (src/files/storage.ts: assertStorageUsable).
STORAGE_DRIVER=local
# Optional key prefix inside the bucket, for a bucket shared with something else.
STORAGE_PREFIX=
STORAGE_FORCE_PATH_STYLE=true

# --- Documented: audit anchor bucket (DEPLOYMENT §4/§7) ----------------------
# The nightly invariant job uploads its audit-chain anchor here, one immutable object per
# verification. The point is a witness the database operator cannot revise, so this belongs in
# a different bucket - and ideally a different provider/account - from the files bucket above.
# With only AUDIT_ANCHOR_BUCKET set, the endpoint, region and credentials are inherited from
# STORAGE_*; set them all to keep the anchor somewhere else entirely.
# Unset means the verification is recorded only in `audit_anchors` and the job says so in its
# detail - it does not pretend the chain was anchored (src/ops/audit-anchor.ts).
AUDIT_ANCHOR_BUCKET=
AUDIT_ANCHOR_ENDPOINT=
AUDIT_ANCHOR_REGION=
AUDIT_ANCHOR_ACCESS_KEY_ID=
AUDIT_ANCHOR_SECRET_ACCESS_KEY=
AUDIT_ANCHOR_PREFIX=
AUDIT_ANCHOR_FORCE_PATH_STYLE=

# --- Documented: messaging (ADR-007 port) ------------------------------------
# mock | openwa. M2 ships the mock provider only; the OpenWA adapter lands in M7
# after spike S1 records O18-O22 (OPENWA_INTEGRATION §2).
MESSAGING_PROVIDER=mock
OPENWA_BASE_URL=http://localhost:2785
OPENWA_API_KEY=
OPENWA_SESSION_ID=
OPENWA_WEBHOOK_SECRET=
WEBHOOK_ALLOWED_IPS=

# --- Documented: seed default ------------------------------------------------
ACADEMY_TIMEZONE_DEFAULT=Asia/Colombo

# --- Implementation detail: dev seed only ------------------------------------
# Production owners are created with `npm run create-owner`; no default credentials exist.
DEV_OWNER_USERNAME=owner
DEV_OWNER_PASSWORD=inspire-academy-dev-owner

# --- Implementation detail: worker (DEPLOYMENT §8) ---------------------------
# The worker writes through the migrator role, like the operator CLIs: there is no session to
# authenticate and none of its jobs are a user action. It reuses DATABASE_MIGRATOR_URL above.
# How often the scheduler looks for due jobs, and how often it touches its heartbeat row.
WORKER_TICK_MS=15000
WORKER_HEARTBEAT_MS=60000
# A run still marked `running` after this long is a stuck job (ops.stuck_jobs sweeps it).
WORKER_STUCK_MINUTES=10
# /system/health alerts when the last worker activity is older than this (DEPLOYMENT §6).
WORKER_STALE_MINUTES=5
# Where the nightly logical dump is written. A production deployment ships it off-host
# (DEPLOYMENT §7); BACKUP_* keys are not used by the job itself.
BACKUP_DIR=var/backups

# --- Implementation detail: retention (DATABASE §6; OPEN-009 confirms the financial ones) --
# Operational history the worker prunes. Financial records are never touched by this.
RETENTION_JOB_RUN_DAYS=14
# A failed run is kept far longer than a healthy one, because it is the evidence.
RETENTION_FAILED_JOB_RUN_DAYS=90
# Idempotency keys are documented at 72 h (API_CONTRACTS §1); 3 days is that plus slack.
RETENTION_IDEMPOTENCY_DAYS=3
# Expired/revoked invoice access tokens.
RETENTION_INVOICE_LINK_DAYS=30
# Payment proofs are the one artefact that cannot be re-created — DO NOT lower casually.
RETENTION_PROOF_MONTHS=24
# Financial rows (invoices, payments, receipts) — reported by the invariant job, never deleted.
RETENTION_FINANCIAL_YEARS=7
