# Caddy for the Inspire Academy API (DEPLOYMENT_AND_OPERATIONS §2).
#
# CURRENT STATE: HTTP-only on port 80.
#
# The academy has no domain configured yet — no DNS A record pointing at this VPS and no
# mailbox for Let's Encrypt notices — so this file deliberately has NO site hostname.
# Caddy then serves plain HTTP and never attempts ACME. Pointing it at a hostname it
# cannot validate made Caddy log a certificate failure every minute and answer every
# request with a 308 to an HTTPS port that had no certificate.
#
# TO TURN HTTPS ON, once api.<domain> resolves to this VPS:
#   1. set API_HOST and ACME_EMAIL in .env.production to the real values;
#   2. replace the `:80 {` site address below with `{$API_HOST} {`;
#   3. docker compose -f docker-compose.prod.yml --env-file .env.production --profile localdb up -d caddy
#      — Caddy then obtains and renews the certificate itself. Nothing below that line changes.
#
# Only the API is proxied here. The frontend goes on a static/SSR host (Vercel, Cloudflare
# Pages) at APP_HOST — DEPLOYMENT §2's recommendation — because the session cookie is
# `SameSite=Lax` and works across origins only while both hosts share a registrable domain
# (`app.x.lk` + `api.x.lk`). `COOKIE_DOMAIN` may stay empty: the API's cookie is host-only,
# which is the safer setting and is sufficient for that arrangement.

{
	# Used only once a hostname site exists; harmless (and unused) over plain HTTP.
	email {$ACME_EMAIL}
	log {
		# stdout, so `docker compose logs -f caddy` is the one place to look and Docker's
		# json-file driver does the rotation. A file inside the container would be a second,
		# less discoverable copy.
		format json
	}
}

# Was `{$API_HOST} {` — see the HTTPS note at the top of this file.
:80 {
	encode zstd gzip

	log {
		output stdout
		format json
	}

	# The largest upload any endpoint accepts is PRF-01's 5 MiB proof, and the backend's own
	# multipart limit is that same number (src/http/plugins.ts). 10 MiB here is headroom for
	# multipart framing, not a second policy.
	request_body {
		max_size 10MiB
	}

	# No `header_up X-Request-Id`: the API owns request ids. It echoes a well-formed inbound one
	# and otherwise generates a UUID, and it returns the value in `X-Request-Id` — which is what
	# to search the API logs by. Inventing a second id at the proxy would only add a number
	# nothing correlates.
	reverse_proxy api:3200

	# HSTS is set by the API's helmet config when NODE_ENV=production (max-age 180 days,
	# includeSubDomains), deliberately NOT duplicated here: two sources for one header is how
	# they drift.
}
