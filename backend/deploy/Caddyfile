# Caddy for the Inspire Academy deployment (DEPLOYMENT_AND_OPERATIONS §2).
#
# CURRENT STATE: HTTP-only on port 80, serving the app AND the API from one origin.
#
# The academy has no domain configured *yet* in DNS (no A record, and no mailbox for Let's Encrypt
# notices), so this file deliberately has NO site hostname. Caddy then serves plain HTTP and never
# attempts ACME. Pointing it at a hostname it could not validate made Caddy log a certificate failure
# every minute and answer every request with a 308 to an HTTPS port that had no certificate.
#
# TO TURN HTTPS ON, once `inspire-player.lk` resolves to this VPS:
#   1. set API_HOST and ACME_EMAIL in .env.production to the real values;
#   2. replace the `:80 {` site address below with `{$API_HOST} {`;
#   3. set COOKIE_SECURE=true in .env.production — a `Secure` cookie is discarded by the browser over
#      plain HTTP, which is why it is false for this pilot (handoff §12.5);
#   4. docker compose -f docker-compose.prod.yml --env-file .env.production --profile localdb up -d caddy
#      — Caddy then obtains and renews the certificate itself. Nothing below that line changes.
#
# ONE ORIGIN, TWO SERVICES. `/api/*` is the API; everything else is the Next.js app. Serving both
# from the same hostname is not a convenience detail: the session cookie is `SameSite=Lax`, so a
# cookie set by the API is only sent on app requests when the two share an origin (or, at best, a
# registrable domain). Same origin means there is no CORS to configure and no cookie-domain reasoning
# to get wrong. `NEXT_PUBLIC_API_BASE_URL` is therefore relative (`/api/v1`), and the app also stops
# depending on the public name resolving from inside its own container.

{
	# Used only once a hostname site exists; harmless (and unused) over plain HTTP.
	email {$ACME_EMAIL}
	log {
		# stdout, so `docker compose logs -f caddy` is the one place to look and Docker's
		# json-file driver does the rotation. A file inside the container would be a second,
		# less discoverable copy.
		format json
	}
}

# Was `{$API_HOST} {` — see the HTTPS note at the top of this file.
:80 {
	encode zstd gzip

	log {
		output stdout
		format json
	}

	# The largest upload any endpoint accepts is PRF-01's 5 MiB proof, and the backend's own
	# multipart limit is that same number (src/http/plugins.ts). 10 MiB here is headroom for
	# multipart framing, not a second policy.
	request_body {
		max_size 10MiB
	}

	# The API keeps its own `/api/v1` prefix — the router mounts every contract route under it and
	# the app calls `${NEXT_PUBLIC_API_BASE_URL}${path}` with paths like `/auth/me`.
	#
	# No `header_up X-Request-Id`: the API owns request ids. It echoes a well-formed inbound one
	# and otherwise generates a UUID, and it returns the value in `X-Request-Id` — which is what
	# to search the API logs by. Inventing a second id at the proxy would only add a number
	# nothing correlates.
	handle /api/* {
		reverse_proxy api:3200
	}

	# Everything else is the app: the pages, `/login`, `/accept-invite`, the static assets.
	handle {
		reverse_proxy web:3100
	}

	# HSTS is set by the API's helmet config when NODE_ENV=production (max-age 180 days,
	# includeSubDomains), deliberately NOT duplicated here: two sources for one header is how
	# they drift.
}
