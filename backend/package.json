{
  "name": "ia-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Inspire Academy management system — backend (M2 foundation).",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch src/server.ts",
    "worker": "tsx src/worker/index.ts",
    "worker:watch": "tsx watch src/worker/index.ts",
    "worker:once": "tsx src/worker/index.ts --once",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/server.js",
    "start:worker": "node dist/src/worker/index.js",
    "openapi": "tsx scripts/generate-openapi.ts",
    "openapi:lint": "redocly lint ../api/openapi.yaml",
    "db:up": "tsx scripts/db.ts up",
    "db:down": "tsx scripts/db.ts down",
    "db:status": "tsx scripts/db.ts status",
    "db:destroy": "tsx scripts/db.ts destroy",
    "bootstrap": "tsx scripts/bootstrap-roles.ts",
    "migrate": "tsx scripts/migrate.ts",
    "migrate:seed": "tsx scripts/migrate.ts --seed",
    "seed": "tsx scripts/migrate.ts --seed",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "db:setup": "npm run bootstrap && npm run migrate:seed",
    "create-owner": "tsx scripts/create-owner.ts",
    "reset-owner": "tsx scripts/reset-owner.ts",
    "invoice-message": "tsx scripts/invoice-message.ts",
    "check:invoices": "tsx scripts/invoice-health.ts",
    "storage:probe": "tsx scripts/storage-probe.ts",
    "test": "vitest run --project unit",
    "test:unit": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "test:report": "vitest run --reporter=default --reporter=json --outputFile=test-report.json",
    "test:assert-report": "node scripts/assert-test-report.mjs test-report.json",
    "test:assert-report:self-test": "node scripts/assert-test-report.mjs --self-test"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.3.0",
    "@types/pdfkit": "^0.17.6",
    "argon2": "^0.45.1",
    "dotenv": "^17.2.3",
    "fastify": "^5.12.7",
    "otplib": "^13.5.0",
    "pdfkit": "^0.15.2",
    "pg": "^8.23.1",
    "yaml": "^2.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@redocly/cli": "^2.62.2",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "embedded-postgres": "^18.4.0-beta.17",
    "tsx": "^4.20.7",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  }
}
